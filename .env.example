# Copy to .env (`make env` or `cp .env.example .env`) and replace every change-me value.
# .env is git-ignored. Never commit real secrets. In production, inject these from the secrets
# manager instead of a file (FRD FR-SEC-026).
#
# Generate strong values, e.g.:  openssl rand -base64 32

# ---- General
APP_ENV=development
LOG_LEVEL=info
IMAGE_TAG=local

# ---- Edge ports on the host
HTTP_PORT=80
HTTPS_PORT=443

# ---- MySQL
MYSQL_ROOT_PASSWORD=change-me-mysql-root
DB_NAME=school_platform
DB_USER=school_app
DB_PASSWORD=change-me-mysql-app

# ---- Redis
REDIS_PASSWORD=change-me-redis

# ---- Tenancy (single tenant at launch; hosts resolve to the default tenant)
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_HOSTS=localhost,portal.localhost,www.localhost

# ---- Object storage (S3-compatible). Dev uses MinIO with these as root credentials.
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_BUCKET_PREFIX=school-platform

# ---- Email (dev overrides to Mailpit automatically)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid

# ---- Auth (key file mounted at runtime; never put key material in this file)
JWT_SIGNING_KEY_FILE=/run/secrets/jwt_signing_key.pem

# ---- API process
API_WORKERS=2

# ---- Dev-only localhost ports (docker-compose.override.yml)
MYSQL_DEV_PORT=3306
REDIS_DEV_PORT=6379
API_DEV_PORT=8000
MINIO_API_DEV_PORT=9000
MINIO_CONSOLE_DEV_PORT=9001
MAILPIT_UI_DEV_PORT=8025

# ---- Backups (infra/scripts/backup_mysql.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
