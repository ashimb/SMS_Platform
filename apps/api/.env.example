# API settings for running outside Docker (uv run uvicorn app.main:app --reload).
# Copy to apps/api/.env and replace every change-me value. Inside Docker Compose these come from
# the repository-root .env instead. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=info

# MySQL (docker compose publishes it on 127.0.0.1:3306 in dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_platform
DB_USER=school_app
DB_PASSWORD=change-me-mysql-app

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# Tenancy (single tenant in v1)
DEFAULT_TENANT_ID=01920000-0000-7000-8000-000000000001
DEFAULT_TENANT_SLUG=default
TENANT_RESOLUTION=default

# JWT signing key (Ed25519 PEM). Optional in development (an ephemeral key is generated);
# REQUIRED in staging/production. Generate with:
#   openssl genpkey -algorithm ed25519 -out jwt_signing_key.pem
JWT_SIGNING_KEY_FILE=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=43200

# Fernet key for TOTP secrets. Optional in development; REQUIRED in staging/production.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Cookies (keep COOKIE_SECURE=true; the dev stack is served over HTTPS by nginx)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# CORS: leave empty (portal is same-origin). JSON list if ever needed: ["https://portal.localhost"]
CORS_ORIGINS=[]

# Rate limits (requests per window, per client IP and tenant)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Object storage (MinIO in dev)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_BUCKET_PREFIX=school-platform

# Error tracking (optional)
SENTRY_DSN=

# Seed script (dev only). Leave passwords empty to generate random ones.
SEED_ADMIN_EMAIL=admin@greenvalley.example.com
SEED_ADMIN_PASSWORD=
