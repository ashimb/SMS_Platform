# Website settings. Copy to apps/website/.env.local for `npm run dev`. Inside Docker Compose the
# website container gets API_INTERNAL_URL from docker-compose.yml. Never commit real secrets.

# Public origin (canonical URLs, sitemap, Open Graph, same-origin checks).
SITE_URL=http://localhost:3000

# "mock": typed fixtures and a mocked enquiry endpoint (until the API CMS/admissions modules exist).
# "api": read public CMS endpoints from API_INTERNAL_URL.
WEBSITE_DATA_SOURCE=mock
API_INTERNAL_URL=http://127.0.0.1:8000

# Shared secret for the signed revalidation webhook (HMAC-SHA256). Required in production; the
# endpoint refuses every request while it is unset.   openssl rand -base64 48
REVALIDATE_SECRET=

# Comma-separated HTTPS hostnames allowed for next/image and the CSP img-src (CDN, media bucket).
WEBSITE_MEDIA_HOSTS=

# Enquiry proxy rate limit (per client IP, per instance; nginx adds a coarse edge limit).
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_SECONDS=600
