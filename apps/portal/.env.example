# Portal (Vite) environment. Copy to .env.local for local overrides. No secrets belong here:
# every VITE_* value is compiled into public JavaScript.

# Dev-only API mocking with MSW (ignored in production builds):
#   all      - mock every endpoint (portal runs without the API)          [default in dev]
#   pending  - mock only endpoints the API does not serve yet (dashboards, password reset)
#   off      - no mocks; everything goes to the API through the dev proxy
VITE_API_MOCKING=all

# Where the dev server proxies /api (server-side only, not exposed to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000
